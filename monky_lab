<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MONKY LAB — Create Your Monky</title>
<meta name="description" content="MONKY LAB — create, customize and share your own MONKY.">
<meta name="theme-color" content="#ffd21c">
<style>
:root{--yellow:#ffd21c;--yellow2:#b58f00;--black:#070707;--panel:#0f0f0f;--panel2:#151515;--line:#292929;--muted:#949494;--white:#fff;--green:#58e39a}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--black);color:var(--white);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;overflow-x:hidden}body:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle at 50% 10%,rgba(255,210,28,.08),transparent 32%);z-index:-1}a{text-decoration:none;color:inherit}button{font:inherit}
.container{width:min(1220px,92%);margin:auto}.nav{position:sticky;top:0;z-index:50;background:rgba(7,7,7,.84);backdrop-filter:blur(16px);border-bottom:1px solid #202020}.navin{height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}.logo{font-weight:1000;font-size:24px;letter-spacing:-1px}.logo span{color:var(--yellow)}.navlinks{display:flex;gap:24px;font-weight:800;font-size:13px;color:#ddd}.navlinks a:hover{color:var(--yellow)}.navbtn{padding:11px 16px;border:1px solid var(--yellow);border-radius:12px;background:var(--yellow);color:#111;font-weight:1000;box-shadow:0 4px 0 var(--yellow2)}
.hero{padding:90px 0 35px;text-align:center}.eyebrow{color:var(--yellow);font-size:12px;font-weight:1000;letter-spacing:4px;text-transform:uppercase}.hero h1{font-size:clamp(52px,9vw,105px);line-height:.86;letter-spacing:-6px;margin:14px 0}.hero h1 span{color:var(--yellow)}.hero p{max-width:700px;margin:0 auto;color:var(--muted);font-size:17px;line-height:1.7}.hero .hint{margin-top:16px;color:#666;font-size:12px}
.lab{padding:30px 0 110px}.labgrid{display:grid;grid-template-columns:minmax(0,1fr) 390px;gap:22px;align-items:start}.stagecard,.panel{background:linear-gradient(145deg,rgba(255,255,255,.035),rgba(255,255,255,.01));border:1px solid var(--line);border-radius:28px}.stagecard{padding:18px;position:sticky;top:94px}.stage{position:relative;width:100%;aspect-ratio:16/11;overflow:hidden;border-radius:22px;background:#050505;border:1px solid #202020;display:grid;place-items:center}.stage img.base{width:100%;height:100%;object-fit:cover;display:block}.stage:after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 52% 45%,transparent 25%,rgba(0,0,0,.15) 70%,rgba(0,0,0,.55));mix-blend-mode:multiply}.overlay{position:absolute;inset:0;pointer-events:none;display:block}.overlay span{position:absolute;filter:drop-shadow(0 7px 8px rgba(0,0,0,.35));user-select:none}.nameplate{position:absolute;left:18px;bottom:16px;z-index:6;background:rgba(0,0,0,.66);border:1px solid rgba(255,255,255,.15);border-radius:13px;padding:10px 13px;backdrop-filter:blur(10px)}.nameplate b{display:block;font-size:15px}.nameplate small{color:#aaa}.rarity{position:absolute;right:18px;bottom:16px;z-index:6;padding:10px 13px;border-radius:13px;background:rgba(255,210,28,.95);color:#111;font-size:11px;font-weight:1000;text-transform:uppercase;letter-spacing:1px}
.stageactions{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}.action{padding:12px;border-radius:13px;border:1px solid #333;background:#151515;color:#fff;font-weight:900;cursor:pointer}.action:hover{border-color:#555;background:#1b1b1b}.action.primary{background:var(--yellow);color:#111;border-color:var(--yellow);box-shadow:0 4px 0 var(--yellow2)}
.panel{padding:22px}.panelhead{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px}.panelhead h2{margin:0;font-size:24px}.counter{font-size:11px;color:#888;background:#181818;border:1px solid #282828;padding:7px 9px;border-radius:10px}.tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-bottom:16px}.tab{padding:10px 8px;border-radius:10px;border:1px solid #2b2b2b;background:#111;color:#aaa;font-size:11px;font-weight:900;cursor:pointer}.tab.active{background:var(--yellow);color:#111;border-color:var(--yellow)}.category{display:none}.category.active{display:block}.sectiontitle{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#777;margin:12px 0 10px}.options{display:grid;grid-template-columns:1fr 1fr;gap:9px}.opt{position:relative;border:1px solid #292929;background:#121212;border-radius:14px;padding:11px;cursor:pointer;text-align:left;color:#ddd}.opt:hover{border-color:#4a4a4a;transform:translateY(-1px)}.opt.active{border-color:var(--yellow);box-shadow:0 0 0 1px rgba(255,210,28,.25) inset;background:#17150b}.opt .emoji{font-size:26px;display:block;margin-bottom:5px}.opt b{font-size:12px}.opt small{display:block;color:#777;margin-top:2px;font-size:10px}.pill{position:absolute;right:8px;top:8px;font-size:8px;padding:3px 5px;border-radius:5px;background:#262626;color:#999}.pill.legendary{background:#3d3000;color:var(--yellow)}
.info{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}.statbox{background:#111;border:1px solid #242424;border-radius:15px;padding:13px}.statbox small{display:block;color:#777;font-size:10px;text-transform:uppercase;letter-spacing:1.4px}.statbox b{display:block;color:var(--yellow);font-size:22px;margin-top:3px}.dna{margin-top:14px;background:#111;border:1px solid #242424;border-radius:17px;padding:15px}.dnahead{display:flex;justify-content:space-between;align-items:center}.dnahead b{font-size:14px}.dnahead span{font-size:10px;color:#666}.meter{height:9px;background:#242424;border-radius:20px;overflow:hidden;margin-top:11px}.meter i{display:block;height:100%;width:0;background:var(--yellow);transition:.35s}.dnafooter{display:flex;justify-content:space-between;color:#777;font-size:10px;margin-top:6px}
.features{padding:20px 0 100px}.featuregrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.feature{padding:24px;border:1px solid var(--line);border-radius:22px;background:#0d0d0d}.feature .big{font-size:30px}.feature h3{margin:12px 0 6px}.feature p{margin:0;color:#888;line-height:1.6;font-size:14px}
.wall{padding:20px 0 100px}.wallhead{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:18px}.wallhead h2{font-size:44px;letter-spacing:-2px;margin:0}.wallhead p{color:#777;max-width:560px;margin:5px 0 0}.wallgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.mini{background:#0f0f0f;border:1px solid #252525;border-radius:20px;overflow:hidden}.miniart{aspect-ratio:1/1;background:#050505;display:grid;place-items:center;position:relative;overflow:hidden}.miniart img{width:100%;height:100%;object-fit:cover}.miniemoji{position:absolute;font-size:78px;right:24px;bottom:10px;filter:drop-shadow(0 8px 8px rgba(0,0,0,.5))}.minifoot{padding:14px}.minifoot b{font-size:13px}.minifoot small{display:block;color:#777;margin-top:3px}
.footer{border-top:1px solid #222;padding:45px 0 55px;color:#777}.footerin{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.footer strong{color:#fff}.social{display:flex;gap:14px}.social a:hover{color:var(--yellow)}
.toast{position:fixed;left:50%;bottom:25px;transform:translate(-50%,20px);background:#171717;border:1px solid #383838;color:#fff;padding:12px 16px;border-radius:12px;opacity:0;pointer-events:none;transition:.25s;z-index:100}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:980px){.labgrid{grid-template-columns:1fr}.stagecard{position:relative;top:auto}.wallgrid{grid-template-columns:1fr 1fr}.featuregrid{grid-template-columns:1fr}}
@media(max-width:640px){.navlinks{display:none}.navin{height:68px}.navbtn{padding:9px 12px;font-size:12px}.hero{padding-top:70px}.hero h1{letter-spacing:-4px}.stage{aspect-ratio:1/1}.options{grid-template-columns:1fr 1fr}.wallgrid{grid-template-columns:1fr}.stageactions{grid-template-columns:1fr}.info{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<nav class="nav"><div class="container navin"><a class="logo" href="#">🐒 <span>MONKY</span> LAB</a><div class="navlinks"><a href="#lab">CREATE</a><a href="#wall">MONKY WALL</a><a href="#about">WHY MONKY</a></div><a class="navbtn" href="index"  rel="noopener">HOME</a></div></nav>

<header class="hero container" id="about"><div class="eyebrow">THE OFFICIAL MONKY LAB</div><h1>CREATE YOUR <span>MONKY.</span></h1><p>Pick your vibe, add accessories, roll the dice and create a MONKY that feels like yours. Every creation gets its own MONKY DNA.</p><div class="hint">Tip: use RANDOM MONKY for a surprise build.</div></header>

<main class="lab" id="lab"><div class="container labgrid">
  <section class="stagecard">
    <div class="stage" id="stage">
      <img class="base" src="monkylab.png" alt="MONKY base character">
      <div class="overlay" id="overlay"></div>
      <div class="nameplate"><b id="monkyName">MONKY #0001</b><small id="monkyStyle">OG STREET</small></div>
      <div class="rarity" id="rarity">COMMON</div>
    </div>
    <div class="stageactions">
      <button class="action primary" id="randomBtn">🎲 RANDOM</button>
      <button class="action" id="saveBtn">💾 SAVE PNG</button>
      <button class="action" id="shareBtn">𝕏 SHARE X</button>
    </div>
  </section>

  <aside class="panel">
    <div class="panelhead"><h2>Customize</h2><span class="counter" id="count">4 / 12</span></div>
    <div class="tabs">
      <button class="tab active" data-tab="style">STYLE</button>
      <button class="tab" data-tab="head">HEAD</button>
      <button class="tab" data-tab="face">FACE</button>
      <button class="tab" data-tab="item">ITEMS</button>
    </div>

    <div class="category active" id="cat-style">
      <div class="sectiontitle">Outfit vibe</div>
      <div class="options">
        <button class="opt active" data-type="style" data-id="street"><span class="emoji">🧥</span><b>Street</b><small>OG MONKY energy</small></button>
        <button class="opt" data-type="style" data-id="boss"><span class="emoji">🕴️</span><b>Boss</b><small>Boardroom chaos</small></button>
        <button class="opt" data-type="style" data-id="space"><span class="emoji">🚀</span><b>Cosmic</b><small>Zero gravity</small><span class="pill">EPIC</span></button>
        <button class="opt" data-type="style" data-id="ninja"><span class="emoji">🥷</span><b>Ninja</b><small>Silent banana</small><span class="pill">RARE</span></button>
        <button class="opt" data-type="style" data-id="king"><span class="emoji">👑</span><b>King</b><small>Monky royalty</small><span class="pill legendary">LEGEND</span></button>
        <button class="opt" data-type="style" data-id="football"><span class="emoji">🏈</span><b>Player</b><small>Game day</small><span class="pill">RARE</span></button>
      </div>
    </div>

    <div class="category" id="cat-head">
      <div class="sectiontitle">Headgear</div>
      <div class="options">
        <button class="opt active" data-type="head" data-id="cap"><span class="emoji">🧢</span><b>OG Cap</b><small>Backwards</small></button>
        <button class="opt" data-type="head" data-id="crown"><span class="emoji">👑</span><b>King Crown</b><small>Royal energy</small><span class="pill legendary">LEGEND</span></button>
        <button class="opt" data-type="head" data-id="cowboy"><span class="emoji">🤠</span><b>Cowboy</b><small>Banana ranch</small><span class="pill">RARE</span></button>
        <button class="opt" data-type="head" data-id="samurai"><span class="emoji">⛑️</span><b>Samurai</b><small>Warrior mode</small><span class="pill">EPIC</span></button>
        <button class="opt" data-type="head" data-id="halo"><span class="emoji">😇</span><b>Halo</b><small>Too innocent</small></button>
        <button class="opt" data-type="head" data-id="none"><span class="emoji">🚫</span><b>No Hat</b><small>Pure monky</small></button>
      </div>
    </div>

    <div class="category" id="cat-face">
      <div class="sectiontitle">Face mode</div>
      <div class="options">
        <button class="opt active" data-type="face" data-id="normal"><span class="emoji">👀</span><b>OG Eyes</b><small>Classic</small></button>
        <button class="opt" data-type="face" data-id="cool"><span class="emoji">😎</span><b>Cool</b><small>Too cool</small></button>
        <button class="opt" data-type="face" data-id="laser"><span class="emoji">🔴</span><b>Laser Eyes</b><small>Maximum chaos</small><span class="pill">EPIC</span></button>
        <button class="opt" data-type="face" data-id="money"><span class="emoji">🤑</span><b>Money Face</b><small>Banana rich</small></button>
        <button class="opt" data-type="face" data-id="party"><span class="emoji">🥳</span><b>Party</b><small>Weekend mode</small></button>
        <button class="opt" data-type="face" data-id="none"><span class="emoji">❌</span><b>Clean</b><small>No extra effect</small></button>
      </div>
    </div>

    <div class="category" id="cat-item">
      <div class="sectiontitle">Accessory</div>
      <div class="options">
        <button class="opt active" data-type="item" data-id="banana"><span class="emoji">🍌</span><b>Banana</b><small>Mandatory</small></button>
        <button class="opt" data-type="item" data-id="chain"><span class="emoji">💎</span><b>Diamond Chain</b><small>Flex mode</small><span class="pill">RARE</span></button>
        <button class="opt" data-type="item" data-id="guitar"><span class="emoji">🎸</span><b>Guitar</b><small>Rocking monky</small></button>
        <button class="opt" data-type="item" data-id="rocket"><span class="emoji">🚀</span><b>Rocket</b><small>To the moon</small></button>
        <button class="opt" data-type="item" data-id="money"><span class="emoji">💰</span><b>Bag</b><small>Big banana bag</small><span class="pill">EPIC</span></button>
        <button class="opt" data-type="item" data-id="none"><span class="emoji">🚫</span><b>Nothing</b><small>Keep it simple</small></button>
      </div>
    </div>

    <div class="info"><div class="statbox"><small>Class</small><b id="classValue">OG</b></div><div class="statbox"><small>Power</small><b id="powerValue">54</b></div></div>
    <div class="dna"><div class="dnahead"><b>🧬 MONKY DNA</b><span id="dnaCode">M0N-KY01</span></div><div class="meter"><i id="powerMeter"></i></div><div class="dnafooter"><span>CHAOS</span><span id="dnaText">Balanced</span><span>MAX MONK</span></div></div>
  </aside>
</div></main>

<section class="features"><div class="container featuregrid"><div class="feature"><div class="big">🎲</div><h3>Random MONKY</h3><p>One click creates a surprise combination using different styles, headgear, faces and accessories.</p></div><div class="feature"><div class="big">🧬</div><h3>MONKY DNA</h3><p>Your combination gets a generated class, power score and unique-looking code for the character card.</p></div><div class="feature"><div class="big">📸</div><h3>Share the meme</h3><p>Save your current creation as a PNG or send a ready-to-post message to X.</p></div></div></section>

<section class="wall" id="wall"><div class="container"><div class="wallhead"><div><div class="eyebrow">COMMUNITY</div><h2>MONKY WALL</h2></div><p>A live-style showcase of example MONKY builds. Replace these cards later with real community submissions.</p></div><div class="wallgrid">
  <article class="mini"><div class="miniart"><img src="monkylab1.png" alt=""><div class="miniemoji">👑</div></div><div class="minifoot"><b>MONKY #7421</b><small>King • Legendary</small></div></article>
  <article class="mini"><div class="miniart"><img src="monkylab2.png" alt=""><div class="miniemoji">😎</div></div><div class="minifoot"><b>MONKY #1937</b><small>OG • Cool</small></div></article>
  <article class="mini"><div class="miniart"><img src="monkylab3.png" alt=""><div class="miniemoji">🥷</div></div><div class="minifoot"><b>MONKY #8812</b><small>Ninja • Rare</small></div></article>
  <article class="mini"><div class="miniart"><img src="monkylab4.png" alt=""><div class="miniemoji">🚀</div></div><div class="minifoot"><b>MONKY #5008</b><small>Cosmic • Epic</small></div></article>
</div></div></section>

<footer class="footer"><div class="container footerin"><div>🐒 <strong>MONKY LAB</strong> — Make your own chaos.</div><div class="social"><a href="#lab">Create</a><a href="#wall">Wall</a><a href="https://x.com/monkycoinof" target="_blank" rel="noopener">X</a></div></div></footer>
<div class="toast" id="toast"></div>

<script>
const state={style:'street',head:'cap',face:'normal',item:'banana'};
const effects={
 style:{street:{emoji:'🧥',cls:'OG STREET',power:4,color:'#ddd'},boss:{emoji:'🕴️',cls:'CEO MONKY',power:12},space:{emoji:'🚀',cls:'COSMIC MONKY',power:22},ninja:{emoji:'🥷',cls:'SHADOW MONKY',power:19},king:{emoji:'👑',cls:'KING MONKY',power:30},football:{emoji:'🏈',cls:'GAME MONKY',power:15}},
 head:{cap:{emoji:'🧢',power:2},crown:{emoji:'👑',power:18},cowboy:{emoji:'🤠',power:9},samurai:{emoji:'⛑️',power:16},halo:{emoji:'😇',power:8},none:{emoji:'',power:0}},
 face:{normal:{emoji:'',power:0},cool:{emoji:'😎',power:8},laser:{emoji:'🔴',power:18},money:{emoji:'🤑',power:6},party:{emoji:'🥳',power:10},none:{emoji:'',power:0}},
 item:{banana:{emoji:'🍌',power:3},chain:{emoji:'💎',power:15},guitar:{emoji:'🎸',power:7},rocket:{emoji:'🚀',power:17},money:{emoji:'💰',power:20},none:{emoji:'',power:0}}
};
const pos={head:{cap:[58,17],crown:[56,8],cowboy:[54,4],samurai:[55,5],halo:[59,0]},face:{cool:[57,39],laser:[62,42],money:[57,42],party:[58,39]},item:{banana:[73,63],chain:[57,57],guitar:[72,62],rocket:[77,50],money:[75,61]}};
const overlay=document.getElementById('overlay');
function addLayer(type,id){const e=effects[type]?.[id]; if(!e||!e.emoji)return; const s=document.createElement('span');s.textContent=e.emoji; const [x,y]=pos[type]?.[id]||[50,50]; const size=type==='head'?52:type==='face'?46:50; s.style.left=x+'%';s.style.top=y+'%';s.style.transform='translate(-50%,-50%) rotate('+(type==='item'?'-8':'0')+'deg)';s.style.fontSize=size+'px';s.dataset.type=type;s.dataset.id=id;overlay.appendChild(s)}
function render(){overlay.innerHTML='';addLayer('head',state.head);addLayer('face',state.face);addLayer('item',state.item);addLayer('style',state.style);const st=effects.style[state.style];document.getElementById('monkyStyle').textContent=st.cls;let power=50;Object.keys(state).forEach(k=>{if(effects[k]?.[state[k]])power+=effects[k][state[k]].power});power=Math.max(40,Math.min(99,power));document.getElementById('powerValue').textContent=power;document.getElementById('powerMeter').style.width=power+'%';document.getElementById('dnaCode').textContent='M0N-'+Math.random().toString(36).slice(2,4).toUpperCase()+Math.random().toString(36).slice(2,5).toUpperCase();let cls=state.style==='king'||power>85?'LEGENDARY':power>70?'EPIC':power>58?'RARE':'COMMON';document.getElementById('rarity').textContent=cls;document.getElementById('classValue').textContent=st.cls.split(' ')[0];document.getElementById('dnaText').textContent=power>85?'MAXIMUM CHAOS':power>70?'CHAOTIC':power>58?'ENERGETIC':'BALANCED';document.getElementById('monkyName').textContent='MONKY #'+Math.floor(1000+Math.random()*8999)}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(window.__toast);window.__toast=setTimeout(()=>t.classList.remove('show'),2200)}

document.querySelectorAll('.tab').forEach(tab=>tab.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.category').forEach(x=>x.classList.remove('active'));tab.classList.add('active');document.getElementById('cat-'+tab.dataset.tab).classList.add('active')}));
document.querySelectorAll('.opt').forEach(opt=>opt.addEventListener('click',()=>{const type=opt.dataset.type;state[type]=opt.dataset.id;document.querySelectorAll('.opt[data-type="'+type+'"]').forEach(x=>x.classList.remove('active'));opt.classList.add('active');render()}));

document.getElementById('randomBtn').addEventListener('click',()=>{for(const type of Object.keys(state)){const keys=Object.keys(effects[type]);state[type]=keys[Math.floor(Math.random()*keys.length)];document.querySelectorAll('.opt[data-type="'+type+'"]').forEach(x=>x.classList.toggle('active',x.dataset.id===state[type]))}render();toast('🎲 New MONKY generated!')});

document.getElementById('shareBtn').addEventListener('click',()=>{const name=document.getElementById('monkyName').textContent;const rarity=document.getElementById('rarity').textContent;const text=`I just created ${name} in the MONKY LAB 🐒🍌\nRarity: ${rarity}\nCreate yours: `;const url='https://x.com/intent/post?text='+encodeURIComponent(text);window.open(url,'_blank','noopener');});

async function savePNG(){const canvas=document.createElement('canvas');const ctx=canvas.getContext('2d');const stage=document.getElementById('stage');canvas.width=1200;canvas.height=825;const img=stage.querySelector('img.base');await new Promise((res,rej)=>{if(img.complete)res();else{img.onload=res;img.onerror=rej}});ctx.drawImage(img,0,0,canvas.width,canvas.height);const scaleX=canvas.width/stage.clientWidth,scaleY=canvas.height/stage.clientHeight;const drawText=(text,x,y,size,fill,weight='900')=>{ctx.save();ctx.font=`${weight} ${size*scaleX}px Inter, Arial`;ctx.fillStyle=fill;ctx.shadowColor='rgba(0,0,0,.5)';ctx.shadowBlur=10*scaleX;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(text,x*scaleX,y*scaleY);ctx.restore()};const layers=overlay.querySelectorAll('span');layers.forEach(el=>{const r=el.getBoundingClientRect(),sr=stage.getBoundingClientRect();const x=r.left-sr.left+r.width/2,y=r.top-sr.top+r.height/2;fontSize=parseFloat(getComputedStyle(el).fontSize);drawText(el.textContent,x,y,fontSize,'#fff')});const barH=72*scaleY;ctx.fillStyle='rgba(0,0,0,.72)';ctx.fillRect(0,canvas.height-barH,canvas.width,barH);ctx.fillStyle='#ffd21c';ctx.font=`900 ${22*scaleX}px Arial`;ctx.fillText(document.getElementById('monkyName').textContent,24*scaleX,canvas.height-43*scaleY);ctx.fillStyle='#fff';ctx.textAlign='right';ctx.font=`700 ${16*scaleX}px Arial`;ctx.fillText(document.getElementById('rarity').textContent+' • '+document.getElementById('classValue').textContent,canvas.width-24*scaleX,canvas.height-43*scaleY);ctx.textAlign='left';const a=document.createElement('a');a.download='my-monky.png';a.href=canvas.toDataURL('image/png');a.click();toast('📸 MONKY saved as PNG!')}
document.getElementById('saveBtn').addEventListener('click',()=>savePNG().catch(()=>toast('Could not create PNG in this browser.')));
render();
</script>
</body>
</html>
